# AWS Core
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# FHIR (Medplum)
MEDPLUM_BASE_URL=http://localhost:8103
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# DynamoDB Table Names
DYNAMO_TABLE_PATIENTS=PatientProfiles
DYNAMO_TABLE_PROTOCOLS=TriageProtocols
DYNAMO_TABLE_RESULTS=CallResults
DYNAMO_TABLE_RULES=ClinicalRules
DYNAMO_TABLE_REVIEWS=ProtocolReview
DYNAMO_ENDPOINT=http://localhost:8000

# Bedrock Models
BEDROCK_MODEL_CARE_PLANNER=amazon.nova-pro-v1:0
BEDROCK_MODEL_EXTRACTOR=amazon.nova-lite-v1:0
BEDROCK_MODEL_SUMMARIZER=amazon.nova-lite-v1:0
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_GUARDRAIL_ID=
CONFIDENCE_THRESHOLD=0.7

# Amazon Connect
CONNECT_INSTANCE_ID=
CONNECT_QUEUE_ID=
CONNECT_PHONE_NUMBER=
CONNECT_CONTACT_FLOW_ID=

# Amazon Lex
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=

# Lambda ARNs - populated after cdk deploy
LAMBDA_ARN_CARE_PLANNER=
LAMBDA_ARN_TRIAGE_ENGINE=
LAMBDA_ARN_SUMMARIZER=
LAMBDA_ARN_CALL_INITIATOR=
LAMBDA_ARN_SMS_FALLBACK=

# AppSync
APPSYNC_ENDPOINT=
APPSYNC_API_KEY=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Notifications
ESCALATION_TOPIC_ARN=
S3_GUIDELINES_BUCKET=
S3_AUDIO_BUCKET=

# Nova Sonic Voice
NOVA_SONIC_TURN_TAKING=MEDIUM
